---
---
<div id="{{ entry.key }}" class="publication-entry">
  <div class="title">{{ entry.title }}</div>

  <div class="author">
    {%- for author in entry.author_array -%}
      {{- author.first }} {{ author.last -}}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor -%}
  </div>

  {% unless entry.status == 'preprint' %}
    {% assign publication_venue = entry.booktitle %}
    {% if entry.journal %}
      {% assign publication_venue = entry.journal %}
    {% endif %}
    <div class="publication-meta">
      {% if publication_venue %}
        <span class="publication-venue">{{ publication_venue }}</span>
      {% endif %}
      {% if entry.year %}
        <span class="publication-year">{{ entry.year }}</span>
      {% endif %}
      {% if entry.highlight %}
        <span class="publication-highlight">{{ entry.highlight }}</span>
      {% endif %}
    </div>
  {% endunless %}

  <div class="links">
    {% if entry.pdf %}
      {% if entry.pdf contains '://' %}
        <a href="{{ entry.pdf }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {% else %}
        <a href="{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}" class="btn btn-sm z-depth-0" role="button">PDF</a>
      {% endif %}
    {% endif %}
    {% if entry.code %}
      <a href="{{ entry.code }}" class="btn btn-sm z-depth-0" role="button">Code</a>
    {% endif %}
    {% if entry.website %}
      <a href="{{ entry.website }}" class="btn btn-sm z-depth-0" role="button">Website</a>
    {% endif %}
  </div>
</div>
